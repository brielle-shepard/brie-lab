# Configure these only in Azure App Service Environment variables.
# Set AZURE_AUTH_ENABLED only after enabling App Service Authentication.
AZURE_AUTH_ENABLED=false
AZURE_TENANT_ID=
BLOG_OWNER_OBJECT_ID=
SITE_ORIGIN=https://YOUR-APP.azurewebsites.net
SITE_VISIBILITY=private
AZURE_STORAGE_TABLE_ENDPOINT=https://YOUR-ACCOUNT.table.core.windows.net
AZURE_STORAGE_TABLE_NAME=BlogPosts
# Local optional alternative: AZURE_STORAGE_CONNECTION_STRING (never commit).
